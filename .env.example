# ================================================================================
# ForexBot — Environment Variables  (MT5 via MetaApi.cloud)
# คัดลอก:  cp .env.example .env   แล้วใส่ค่าจริง
# ================================================================================

# ── MetaApi Credentials ──────────────────────────────────────────────────────
# สมัครฟรีที่ https://app.metaapi.cloud/
METAAPI_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
METAAPI_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Trading Mode ──────────────────────────────────────────────────────────────
DRY_RUN=true        # true = ดู signal + ราคาจริง แต่ไม่ส่ง order จริง
                    # false = ส่ง order จริงไปที่ MT5

# ── Capital ───────────────────────────────────────────────────────────────────
CAPITAL=10000       # 0 = ดึงจาก MT5 balance จริง
LEVERAGE=100

# ── Telegram alerts (used by every live bot) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxx

# ── Gemini (news_gemini_bot.py only) ────────────────────────────────────────────
# API key from https://aistudio.google.com (NOT a login to gemini.google.com --
# needs a real API key with billing enabled, Google Search grounding has a very
# tight free-tier quota that trips 429 almost immediately).
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest
